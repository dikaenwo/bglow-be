[Unit]
Description=B-Glow Flask Backend (Gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/bglow-be
Environment="PATH=/var/www/bglow-be/venv/bin"
EnvironmentFile=/var/www/bglow-be/.env
ExecStart=/var/www/bglow-be/venv/bin/gunicorn \
    -w 4 \
    -b 0.0.0.0:5050 \
    --timeout 120 \
    --access-logfile /var/log/bglow/access.log \
    --error-logfile /var/log/bglow/error.log \
    main:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
